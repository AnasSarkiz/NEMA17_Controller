{
  "name": "NEMA14_CH32X035G8U6",
  "version": "1.0.5",
  "description": "Rear-mount NEMA14 CH32X035 USB-C PD hardware prototype",
  "main": "src/board.tsx",
  "scripts": {
    "build": "npm run render && npm run check",
    "check": "bun scripts/check.ts",
    "dev": "XDG_CONFIG_HOME=/workspace/.config tsci dev artifacts/board.circuit.json",
    "test": "npm run check",
    "render": "bun scripts/render.ts",
    "autoroute": "bun scripts/build.tsx",
    "source:check": "bun scripts/build.tsx --unrouted",
    "export": "XDG_CONFIG_HOME=/workspace/.config tsci export artifacts/board.circuit.json -f gerbers -o \"$PWD/artifacts/nema14-gerbers.zip\"",
    "typecheck": "tsc --noEmit",
    "shorts": "XDG_CONFIG_HOME=/workspace/.config tsci check shorts artifacts/board.circuit.json --mode gerber --layer all --pixels-per-mm 100",
    "publish:tscircuit": "bash scripts/publish-tscircuit.sh",
    "presentation": "npm run source:check && python3 scripts/sync-presentation.py && npm run render && /workspace/.routing-venv/bin/python scripts/export-a4-pdf.py && python3 scripts/report-presentation.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnasSarkiz/NEMA17_Controller.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AnasSarkiz/NEMA17_Controller/issues"
  },
  "homepage": "https://github.com/AnasSarkiz/NEMA17_Controller#readme",
  "dependencies": {
    "@tscircuit/cli": "0.1.2257",
    "circuit-json-to-gerber": "0.0.112",
    "circuit-json-to-kicad": "0.0.230",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "tscircuit": "0.0.2757",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "bun": "1.4.2"
  },
  "private": true
}
